<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Local Leader Directory</title>
  <style>
    :root {
      --afge-blue: #0b3d91;
      --afge-gold: #eab308;
      --bg: #f8fafc;
      --card: #ffffff;
      --border: #cbd5e1;
      --text: #0f172a;
      --muted: #64748b;
    }
    * { box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; -webkit-tap-highlight-color: transparent; }
    body { margin: 0; padding: 12px 8px; background: var(--bg); color: var(--text); }
    .container {
      max-width: 600px;
      margin: 0 auto;
      background: var(--card);
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(15, 23, 42, 0.06);
      overflow: hidden;
    }
    .header {
      background: var(--afge-blue);
      color: #fff;
      padding: 22px 20px;
      border-bottom: 4px solid var(--afge-gold);
      text-align: left;
    }
    .header h1 { margin: 0 0 6px; font-size: 20px; font-weight: 700; letter-spacing: -0.3px; }
    .header p { margin: 0; font-size: 13px; opacity: 0.92; line-height: 1.45; }
    form { padding: 20px 16px; }
    .grid-2 { display: grid; grid-template-columns: 1fr; gap: 16px; }
    @media (min-width: 520px) { .grid-2 { grid-template-columns: 1fr 1fr; gap: 14px; } }
    .field { margin-bottom: 18px; position: relative; }
    label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: var(--text); }
    .req { color: #dc2626; }
    .hint { font-size: 11.5px; color: var(--muted); margin-top: 4px; line-height: 1.35; }
    input[type="text"], input[type="email"], input[type="tel"], input[type="url"], select {
      width: 100%;
      height: 46px; /* Optimized touch target for mobile thumbs */
      padding: 0 14px;
      font-size: 16px; /* Prevents auto-zoom on iOS Safari */
      border: 1.5px solid var(--border);
      border-radius: 8px;
      background: #fff;
      -webkit-appearance: none;
    }
    input:focus, select:focus {
      outline: none;
      border-color: var(--afge-blue);
      box-shadow: 0 0 0 3px rgba(11, 61, 145, 0.12);
    }
    /* Custom Type-to-Search Dropdown List */
    .search-results {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      max-height: 220px;
      overflow-y: auto;
      background: #fff;
      border: 1.5px solid var(--afge-blue);
      border-radius: 8px;
      margin-top: 4px;
      z-index: 50;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
      display: none;
      -webkit-overflow-scrolling: touch;
    }
    .search-item {
      padding: 12px 14px;
      font-size: 14px;
      cursor: pointer;
      border-bottom: 1px solid #f1f5f9;
    }
    .search-item:active { background: #eff6ff; color: var(--afge-blue); font-weight: 600; }
    .search-empty {
      padding: 12px 14px;
      font-size: 13px;
      color: var(--muted);
    }
    .checkbox-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 10px;
      font-size: 13px;
      color: var(--afge-blue);
      cursor: pointer;
      font-weight: 600;
    }
    .checkbox-row input { width: 18px; height: 18px; cursor: pointer; }
    .conditional-box {
      display: none;
      margin-top: 10px;
      padding: 12px;
      background: #f8fafc;
      border: 1px dashed var(--border);
      border-radius: 8px;
    }
    /* Click-to-Add Social Pills - Mobile friendly layout */
    .social-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 8px;
    }
    .social-pill {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 8px 12px;
      font-size: 12.5px;
      font-weight: 600;
      border-radius: 999px;
      border: 1.5px solid var(--border);
      background: #f8fafc;
      color: var(--text);
      cursor: pointer;
      user-select: none;
    }
    .social-pill.active {
      background: var(--afge-blue);
      color: #fff;
      border-color: var(--afge-blue);
    }
    .social-inputs-container {
      margin-top: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .social-input-row {
      display: none;
      align-items: center;
      gap: 8px;
      background: #f8fafc;
      padding: 8px 10px;
      border-radius: 8px;
      border: 1px solid var(--border);
    }
    .social-input-row.active { display: flex; }
    .social-input-row input { height: 40px !important; font-size: 14px !important; }
    .social-label-badge {
      min-width: 80px;
      font-size: 11.5px;
      font-weight: 700;
      color: var(--afge-blue);
    }
    .social-remove-btn {
      background: none;
      border: none;
      color: #94a3b8;
      font-size: 20px;
      cursor: pointer;
      padding: 0 4px;
    }
    .btn-submit {
      width: 100%;
      height: 50px;
      background: var(--afge-blue);
      color: #fff;
      font-weight: 600;
      font-size: 16px;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      margin-top: 8px;
      box-shadow: 0 4px 10px rgba(11, 61, 145, 0.2);
    }
    .btn-submit:active { background: #072a66; }
    .btn-submit:disabled { background: #94a3b8; cursor: not-allowed; box-shadow: none; }
    .error-banner {
      display: none;
      background: #fef2f2;
      color: #b91c1c;
      border: 1px solid #fecaca;
      padding: 12px 14px;
      border-radius: 8px;
      font-size: 13px;
      margin-bottom: 16px;
    }
    .success-screen {
      display: none;
      padding: 36px 20px;
      text-align: center;
    }
    .badge {
      display: inline-block;
      background: #dbeafe;
      color: var(--afge-blue);
      font-weight: 700;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 14px;
      margin: 12px 0;
      word-break: break-all;
    }
  </style>
</head>
<body>

<div class="container">
  <div class="header">
    <h1>Local Leader Directory</h1>
    <p>Register your profile to join the directory and receive access to the directory.</p>
  </div>

  <div id="successScreen" class="success-screen">
    <h2 style="margin-top:0; color:#15803d; font-size:22px;">Registration Submitted!</h2>
    <p style="font-size:14px; color:var(--muted);">Your profile has been sent for review:</p>
    <div id="submittedTag" class="badge"></div>
    <p style="font-size:13.5px; color:var(--muted); line-height:1.5;">
      Once approved, you will receive an email invitation at your registered address to join <strong>local-leader-directory@googlegroups.com</strong>, which unlocks access to the directory.
    </p>
    <button type="button" class="btn-submit" style="margin-top:16px;" onclick="location.reload()">Submit Another Profile</button>
  </div>

  <form id="leaderForm" onsubmit="handleFormSubmit(event)">
    <div id="errorBanner" class="error-banner"></div>

    <div class="grid-2">
      <div class="field">
        <label>First Name <span class="req">*</span></label>
        <input type="text" id="firstName" required placeholder="Jane">
      </div>
      <div class="field">
        <label>Last Name <span class="req">*</span></label>
        <input type="text" id="lastName" required placeholder="Doe">
      </div>
    </div>

    <div class="grid-2">
      <div class="field">
        <label>Email Address <span class="req">*</span></label>
        <input type="email" id="email" required placeholder="you@gmail.com">
        <div class="hint">Email for Google Group access.</div>
      </div>
      <div class="field">
        <label>Phone Number <span class="req">*</span></label>
        <input type="tel" id="phone" required placeholder="(312) 555-0199">
      </div>
    </div>

    <!-- DISTRICT DROPDOWN -->
    <div class="field">
      <label>District <span class="req">*</span></label>
      <select id="district" required>
        <option value="">Loading Districts...</option>
      </select>
    </div>

    <!-- SEARCHABLE AGENCY INPUT -->
    <div class="field" id="agencyField">
      <label>Agency <span class="req">*</span></label>
      <input type="text" id="agencyInput" autocomplete="off" required placeholder="Type agency (e.g., VA, BOP, SSA)...">
      <div id="agencyResults" class="search-results"></div>
      <div class="hint">Tap and type to search your agency.</div>
    </div>

    <!-- SEARCHABLE LOCAL NUMBER INPUT + FALLBACK -->
    <div class="field" id="localField">
      <label>Local Number <span class="req">*</span></label>
      <input type="text" id="localInput" autocomplete="off" placeholder="Type Local number (e.g., 2107)...">
      <div id="localResults" class="search-results"></div>

      <label class="checkbox-row">
        <input type="checkbox" id="unlistedLocalToggle" onchange="toggleUnlistedLocal()">
        If local number not listed, tap here to type manually
      </label>

      <div id="customLocalBox" class="conditional-box">
        <label>Type your Local / Council <span class="req">*</span></label>
        <input type="text" id="customLocalInput" placeholder="e.g., Local 9999 or Council 220">
      </div>
    </div>

    <!-- POSITION DROPDOWN + OTHER -->
    <div class="field">
      <label>Position <span class="req">*</span></label>
      <select id="position" required onchange="toggleCustomPosition()">
        <option value="">Select Position...</option>
      </select>

      <div id="customPositionBox" class="conditional-box">
        <label>If other, please type your position <span class="req">*</span></label>
        <input type="text" id="customPositionInput" placeholder="Type your position title...">
      </div>
    </div>

    <!-- SEPARATE WEBSITE URL -->
    <div class="field">
      <label>Website URL (Optional)</label>
      <input type="text" id="website" placeholder="www.yourlocalwebsite.org">
    </div>

    <!-- CLICK-TO-ADD SOCIAL MEDIA LINKS -->
    <div class="field">
      <label>Social Media Links (Optional — Tap to Add)</label>
      <div class="social-pills" id="socialPills">
        <button type="button" class="social-pill" data-platform="Facebook" onclick="toggleSocialPlatform('Facebook')">+ Facebook</button>
        <button type="button" class="social-pill" data-platform="Instagram" onclick="toggleSocialPlatform('Instagram')">+ Instagram</button>
        <button type="button" class="social-pill" data-platform="X" onclick="toggleSocialPlatform('X')">+ X (Twitter)</button>
        <button type="button" class="social-pill" data-platform="LinkedIn" onclick="toggleSocialPlatform('LinkedIn')">+ LinkedIn</button>
        <button type="button" class="social-pill" data-platform="TikTok" onclick="toggleSocialPlatform('TikTok')">+ TikTok</button>
        <button type="button" class="social-pill" data-platform="YouTube" onclick="toggleSocialPlatform('YouTube')">+ YouTube</button>
        <button type="button" class="social-pill" data-platform="Bluesky" onclick="toggleSocialPlatform('Bluesky')">+ Bluesky</button>
      </div>

      <div class="social-inputs-container" id="socialInputsContainer">
        <div class="social-input-row" id="socialRow-Facebook">
          <span class="social-label-badge">Facebook</span>
          <input type="url" id="socialUrl-Facebook" placeholder="https://facebook.com/...">
          <button type="button" class="social-remove-btn" onclick="toggleSocialPlatform('Facebook')">&times;</button>
        </div>
        <div class="social-input-row" id="socialRow-Instagram">
          <span class="social-label-badge">Instagram</span>
          <input type="url" id="socialUrl-Instagram" placeholder="https://instagram.com/...">
          <button type="button" class="social-remove-btn" onclick="toggleSocialPlatform('Instagram')">&times;</button>
        </div>
        <div class="social-input-row" id="socialRow-X">
          <span class="social-label-badge">X (Twitter)</span>
          <input type="url" id="socialUrl-X" placeholder="https://x.com/...">
          <button type="button" class="social-remove-btn" onclick="toggleSocialPlatform('X')">&times;</button>
        </div>
        <div class="social-input-row" id="socialRow-LinkedIn">
          <span class="social-label-badge">LinkedIn</span>
          <input type="url" id="socialUrl-LinkedIn" placeholder="https://linkedin.com/in/...">
          <button type="button" class="social-remove-btn" onclick="toggleSocialPlatform('LinkedIn')">&times;</button>
        </div>
        <div class="social-input-row" id="socialRow-TikTok">
          <span class="social-label-badge">TikTok</span>
          <input type="url" id="socialUrl-TikTok" placeholder="https://tiktok.com/@...">
          <button type="button" class="social-remove-btn" onclick="toggleSocialPlatform('TikTok')">&times;</button>
        </div>
        <div class="social-input-row" id="socialRow-YouTube">
          <span class="social-label-badge">YouTube</span>
          <input type="url" id="socialUrl-YouTube" placeholder="https://youtube.com/@...">
          <button type="button" class="social-remove-btn" onclick="toggleSocialPlatform('YouTube')">&times;</button>
        </div>
        <div class="social-input-row" id="socialRow-Bluesky">
          <span class="social-label-badge">Bluesky</span>
          <input type="url" id="socialUrl-Bluesky" placeholder="https://bsky.app/profile/...">
          <button type="button" class="social-remove-btn" onclick="toggleSocialPlatform('Bluesky')">&times;</button>
        </div>
      </div>
    </div>

    <button type="submit" id="submitBtn" class="btn-submit">Submit Profile</button>
  </form>
</div>

<script>
  let MASTER_AGENCIES = [];
  let MASTER_LOCALS = [];
  let selectedAgency = '';
  let selectedLocal = '';
  const SOCIAL_PLATFORMS = ['Facebook', 'Instagram', 'X', 'LinkedIn', 'TikTok', 'YouTube', 'Bluesky'];

  window.addEventListener('DOMContentLoaded', () => {
    google.script.run.withSuccessHandler(populateLists).getFormLists();
  });

  function populateLists(data) {
    MASTER_AGENCIES = data.agencies || [];
    MASTER_LOCALS = data.locals || [];

    const distSelect = document.getElementById('district');
    distSelect.innerHTML = '<option value="">Select your District...</option>';
    (data.districts || []).forEach(d => {
      const opt = document.createElement('option');
      opt.value = d;
      opt.textContent = d;
      distSelect.appendChild(opt);
    });

    const posSelect = document.getElementById('position');
    posSelect.innerHTML = '<option value="">Select your Position...</option>';
    (data.positions || []).forEach(p => {
      const opt = document.createElement('option');
      opt.value = p;
      opt.textContent = p;
      posSelect.appendChild(opt);
    });
    const otherOpt = document.createElement('option');
    otherOpt.value = 'Other';
    otherOpt.textContent = 'Other (Please specify)';
    posSelect.appendChild(otherOpt);

    setupAutocomplete('agencyInput', 'agencyResults', () => MASTER_AGENCIES, (val) => { selectedAgency = val; });
    setupAutocomplete('localInput', 'localResults', () => MASTER_LOCALS, (val) => { selectedLocal = val; });
  }

  function setupAutocomplete(inputId, resultsId, getListFn, onSelectFn) {
    const input = document.getElementById(inputId);
    const resultsBox = document.getElementById(resultsId);

    const renderMatches = () => {
      const query = input.value.trim().toLowerCase();
      const list = getListFn();
      onSelectFn('');

      const matches = query === ''
        ? list.slice(0, 30)
        : list.filter(item => item.toLowerCase().includes(query)).slice(0, 40);

      resultsBox.innerHTML = '';
      if (matches.length === 0) {
        const empty = document.createElement('div');
        empty.className = 'search-empty';
        empty.textContent = 'No matching entry found.';
        resultsBox.appendChild(empty);
      } else {
        matches.forEach(item => {
          const div = document.createElement('div');
          div.className = 'search-item';
          div.textContent = item;
          div.addEventListener('click', (e) => {
            e.preventDefault();
            input.value = item;
            onSelectFn(item);
            resultsBox.style.display = 'none';
          });
          resultsBox.appendChild(div);
        });
      }
      resultsBox.style.display = 'block';
    };

    input.addEventListener('focus', renderMatches);
    input.addEventListener('input', renderMatches);
    input.addEventListener('blur', () => {
      setTimeout(() => {
        resultsBox.style.display = 'none';
        const list = getListFn();
        const exact = list.find(i => i.toLowerCase() === input.value.trim().toLowerCase());
        if (exact) {
          input.value = exact;
          onSelectFn(exact);
        }
      }, 200);
    });
  }

  function toggleSocialPlatform(platform) {
    const pill = document.querySelector(`.social-pill[data-platform="${platform}"]`);
    const row = document.getElementById(`socialRow-${platform}`);
    const input = document.getElementById(`socialUrl-${platform}`);

    const isActive = row.classList.contains('active');
    if (isActive) {
      row.classList.remove('active');
      pill.classList.remove('active');
      input.value = '';
    } else {
      row.classList.add('active');
      pill.classList.add('active');
      input.focus();
    }
  }

  function collectSocialLinks() {
    const entries = [];
    SOCIAL_PLATFORMS.forEach(platform => {
      const row = document.getElementById(`socialRow-${platform}`);
      const input = document.getElementById(`socialUrl-${platform}`);
      if (row.classList.contains('active') && input.value.trim() !== '') {
        entries.push(`${platform}: ${input.value.trim()}`);
      }
    });
    return entries.join(' | ');
  }

  function toggleUnlistedLocal() {
    const isChecked = document.getElementById('unlistedLocalToggle').checked;
    const localInput = document.getElementById('localInput');
    const customBox = document.getElementById('customLocalBox');
    const customInput = document.getElementById('customLocalInput');

    if (isChecked) {
      localInput.value = '';
      localInput.disabled = true;
      selectedLocal = '';
      customBox.style.display = 'block';
      customInput.required = true;
      customInput.focus();
    } else {
      localInput.disabled = false;
      customBox.style.display = 'none';
      customInput.required = false;
      customInput.value = '';
    }
  }

  function toggleCustomPosition() {
    const pos = document.getElementById('position').value;
    const box = document.getElementById('customPositionBox');
    const input = document.getElementById('customPositionInput');
    if (pos === 'Other') {
      box.style.display = 'block';
      input.required = true;
      input.focus();
    } else {
      box.style.display = 'none';
      input.required = false;
      input.value = '';
    }
  }

  function showError(msg) {
    const banner = document.getElementById('errorBanner');
    banner.textContent = msg;
    banner.style.display = 'block';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function handleFormSubmit(e) {
    e.preventDefault();
    document.getElementById('errorBanner').style.display = 'none';

    const isUnlistedLocal = document.getElementById('unlistedLocalToggle').checked;

    if (!selectedAgency) {
      showError('Please select a valid Agency from the search results.');
      document.getElementById('agencyInput').focus();
      return;
    }

    if (!isUnlistedLocal && !selectedLocal) {
      showError('Please tap your Local Number from the search list, or check the box to type it manually.');
      document.getElementById('localInput').focus();
      return;
    }

    const payload = {
      firstName: document.getElementById('firstName').value,
      lastName: document.getElementById('lastName').value,
      email: document.getElementById('email').value,
      phone: document.getElementById('phone').value,
      district: document.getElementById('district').value,
      agency: selectedAgency,
      local: selectedLocal,
      isUnlistedLocal: isUnlistedLocal,
      customLocal: document.getElementById('customLocalInput').value,
      position: document.getElementById('position').value,
      customPosition: document.getElementById('customPositionInput').value,
      // Auto-prefix https:// if someone types www. or just the domain name
    let rawWebsite = document.getElementById('website').value.trim();
    if (rawWebsite && !/^https?:\/\//i.test(rawWebsite)) {
      rawWebsite = 'https://' + rawWebsite;
    }

    const payload = {
      firstName: document.getElementById('firstName').value,
      lastName: document.getElementById('lastName').value,
      email: document.getElementById('email').value,
      phone: document.getElementById('phone').value,
      district: document.getElementById('district').value,
      agency: selectedAgency,
      local: selectedLocal,
      isUnlistedLocal: isUnlistedLocal,
      customLocal: document.getElementById('customLocalInput').value,
      position: document.getElementById('position').value,
      customPosition: document.getElementById('customPositionInput').value,
      website: rawWebsite,
      socials: collectSocialLinks()
    };,
      socials: collectSocialLinks()
    };

    const btn = document.getElementById('submitBtn');
    btn.disabled = true;
    btn.textContent = 'Submitting Profile...';

    google.script.run
      .withSuccessHandler((res) => {
        document.getElementById('leaderForm').style.display = 'none';
        document.getElementById('submittedTag').textContent = res.tag;
        document.getElementById('successScreen').style.display = 'block';
        window.scrollTo({ top: 0, behavior: 'smooth' });
      })
      .withFailureHandler((err) => {
        btn.disabled = false;
        btn.textContent = 'Submit Profile';
        showError('Submission error: ' + err.message);
      })
      .submitLeaderRegistration(payload);
  }
</script>
</body>
</html>
